# Based on GitHub's Python .gitignore template (trimmed to what applies here)

# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers and linters
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env

# PyCharm (per-user IDE settings)
.idea/

# Personal Claude Code instructions (not published)
CLAUDE.local.md

# Flight data and logs
logs/
*.csv
flights/
